{
  "name": "shadowapi",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Turn observed HTTP traffic into OpenAPI 3.1, local mocks, and contract diffs",
  "author": "Darko M",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkooom/ShadowAPI.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/darkooom/ShadowAPI#readme",
  "bugs": {
    "url": "https://github.com/darkooom/ShadowAPI/issues"
  },
  "keywords": [
    "api",
    "openapi",
    "proxy",
    "mock-server",
    "contract-testing",
    "api-testing",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "shadowapi": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/index.ts",
    "lint": "eslint src",
    "prepack": "pnpm --workspace-root exec turbo run build --filter=shadowapi --output-logs=errors-only",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@shadowapi/core": "workspace:*",
    "tsup": "^8.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
